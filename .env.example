# ── Vision AI (Claude) — obrigatória nesta fase ──────────────────────────
# Usada pelo backend para analisar os screenshots enviados. Gere em
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Quotex (NÃO usada nesta fase — MVP é via upload de screenshot) ───────
# Mantida aqui apenas para quando a integração em tempo real for retomada.
QUOTEX_EMAIL=
QUOTEX_PASSWORD=
QUOTEX_DEMO_MODE=true

# ── Banco de dados ────────────────────────────────────────────────────────
# Opção A: Postgres próprio (docker-compose)
DATABASE_URL=postgresql+asyncpg://quotex_ai:changeme_local_only@localhost:5432/quotex_ai
POSTGRES_PASSWORD=changeme_local_only

# Opção B: Supabase (alternativa recomendada para reduzir complexidade
# operacional em projetos pequenos/médios — ver ARCHITECTURE.md)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Backend ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ── Frontend (Next.js / Vercel) ─────────────────────────────────────────
# API_URL é PRIVADA (sem prefixo NEXT_PUBLIC_) — usada só pela API route
# server-side em app/api/backend/[...path]/route.ts, que faz proxy das
# chamadas REST. O navegador nunca vê este valor.
API_URL=http://localhost:8000

# NEXT_PUBLIC_BACKEND_WS_URL É pública de propósito: funções serverless da
# Vercel não sustentam proxy de WebSocket persistente, então o navegador
# precisa conectar direto no backend para o stream de candles. Isto é só
# um endereço de serviço (sem credenciais), então expor no bundle é seguro.
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000
